# ============================================================
#  Пример настроек. Скопируйте файл в .env и заполните под себя:
#      cp .env.example .env
#  Файл .env добавлен в .gitignore и в репозиторий не попадает —
#  это важно, потому что там лежат пароли и API-ключи.
# ============================================================

# ---------- База данных PostgreSQL ----------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=gravity_cafe
PG_USER=postgres
PG_PASSWORD=

# ---------- Сервер ----------
PORT=3000

# ============================================================
#  НАСТРОЙКИ ИИ-АССИСТЕНТА
# ============================================================

# Какой провайдер использовать:
#   auto   — сначала локальная Ollama, потом облако (если задан ключ),
#            иначе режим поиска по базе знаний (рекомендуется);
#   ollama — только локальная модель;
#   openai — любой OpenAI-совместимый API;
#   mock   — вообще без языковой модели, детерминированный поиск.
ASSISTANT_PROVIDER=auto

# ---------- Вариант 1: локальная модель через Ollama ----------
# Установка: https://ollama.com  ->  затем в терминале:
#     ollama pull qwen2.5:7b-instruct
# Плюсы: бесплатно, работает без интернета, данные не покидают компьютер.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_MS=120000

# ---------- Вариант 2: OpenAI-совместимый API ----------
# Работает с OpenAI, DeepSeek, OpenRouter, Together, vLLM, LM Studio и др.
# Достаточно поменять базовый URL и модель.
#   OpenAI:     https://api.openai.com/v1                  gpt-4o-mini
#   DeepSeek:   https://api.deepseek.com/v1                deepseek-chat
#   OpenRouter: https://openrouter.ai/api/v1               qwen/qwen-2.5-72b-instruct
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000

# ---------- Режим ответов ----------
#   hybrid — точные факты (калории, состав, аллергены, цены, адрес, часы,
#            подбор по ограничениям) отдаёт детерминированный поиск по базе,
#            а языковая модель отвечает там, где нужен живой текст
#            (рекомендации, история, общие вопросы). Рекомендуется: точные
#            ответы получаются мгновенно и не могут быть выдуманы моделью;
#   llm    — через языковую модель идут все запросы без исключения.
ASSISTANT_ROUTING=hybrid

# ---------- Параметры генерации ----------
# temperature: 0 — строго по фактам, 1 — креативно.
# Для справок о калориях и адресе нужна низкая температура.
ASSISTANT_TEMPERATURE=0.3
ASSISTANT_MAX_TOKENS=700
ASSISTANT_TOP_K=4
ASSISTANT_MAX_TOOL_ITERATIONS=4
ASSISTANT_HISTORY_LIMIT=10

# ---------- Ограничения ----------
ASSISTANT_MAX_MESSAGE_LENGTH=1000
ASSISTANT_RATE_WINDOW_MS=60000
ASSISTANT_RATE_MAX=20

# ---------- Логирование диалогов в PostgreSQL ----------
ASSISTANT_LOGGING=true
ASSISTANT_PROMPT_VERSION=1.0.0
